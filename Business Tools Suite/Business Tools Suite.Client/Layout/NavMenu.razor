@implements IDisposable

@inject NavigationManager NavigationManager
@inject PlaceholderDataService DataService

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="admin">
            <img src="new-era-logo.png" alt="New Era Cleaning logo" class="brand-logo" />
            <span class="brand-name">New Era Cleaning Admin</span>
        </a>
    </div>
</div>

<div class="nav-scrollable">
    <nav class="nav flex-column">
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <a class="nav-link" href="/">
                        <span class="bi bi-box-arrow-up-right-nav-menu" aria-hidden="true"></span> View Public Site
                    </a>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/reviews">
                        <span class="bi bi-star-fill-nav-menu" aria-hidden="true"></span> Reviews
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/quote-requests">
                        <span class="bi bi-inbox-fill-nav-menu" aria-hidden="true"></span> Quote Requests
                        @if (newRequestCount > 0)
                        {
                            <span class="nav-badge">@newRequestCount</span>
                        }
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/clients">
                        <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> Clients
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/analytics">
                        <span class="bi bi-graph-up-nav-menu" aria-hidden="true"></span> Analytics
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Manage">
                        <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> @context.User.Identity?.Name
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link">
                            <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Logout
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Log In
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;
    private int newRequestCount;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

        newRequestCount = DataService.NewQuoteRequestCount;
        DataService.Changed += OnDataChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    private void OnDataChanged()
    {
        newRequestCount = DataService.NewQuoteRequestCount;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        DataService.Changed -= OnDataChanged;
    }
}

