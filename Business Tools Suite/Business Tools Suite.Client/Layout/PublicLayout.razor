@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS

@*
    Public-facing marketing chrome for neweracleaning.com. Wraps anonymous
    marketing pages with a sticky header and a content-rich footer. The admin
    dashboard uses MainLayout instead.

    The footer used to carry a discreet "Staff Admin" link to /admin. It was
    removed so these pages match the WordPress theme, which ships without it
    (see the note at the top of the theme's footer.php) — this app now serves
    only as the local preview of the public site. /admin is unaffected and is
    still reachable by typing the URL.
*@

<div class="public-shell">
    <header class="public-header">
        <div class="public-header-inner">
            <a class="public-brand" href="/">
                <img src="new-era-logo.png" alt="New Era Steam Cleaning &amp; Restoration logo" class="public-brand-logo" />
                <span class="public-brand-text">
                    <span class="public-brand-name">New Era Steam Cleaning</span>
                    <span class="public-brand-sub">&amp; Restoration</span>
                </span>
            </a>

            <input type="checkbox" id="public-nav-toggle" class="public-nav-toggle" @bind="_navOpen" />
            <label for="public-nav-toggle" class="public-nav-burger" aria-label="Toggle navigation">
                <span></span><span></span><span></span>
            </label>

            <nav class="public-nav" aria-label="Primary">
                <a href="/">Home</a>
                <a href="about">About</a>
                <a href="services">Services</a>
                <a href="pricing">Pricing</a>
                <a href="job-photos">Job Photos</a>
                <a href="guarantee">Guarantee</a>
                <a href="quote">Get a Quote</a>
            </nav>

            <a class="public-call" href="tel:+17139060918">
                <span class="bi bi-telephone-fill" aria-hidden="true"></span>
                <span class="public-call-text">
                    <span class="public-call-label">Call for a free quote</span>
                    <span class="public-call-number">(713) 906-0918</span>
                </span>
            </a>
        </div>
    </header>

    <main class="public-main">
        @Body
    </main>

    <footer class="public-footer">
        <div class="public-footer-inner">
            <div class="public-footer-brand">
                <img src="new-era-logo.png" alt="New Era Steam Cleaning &amp; Restoration logo" class="public-footer-logo" />
                <p class="public-footer-tagline">
                    A local, family-owned steam cleaning company proudly serving the
                    greater Houston area since 2014. Guaranteed, bonded &amp; insured.
                </p>
                <p class="public-footer-green">
                    <span class="bi bi-flower1" aria-hidden="true"></span>
                    Organic, all-natural green options available on request.
                </p>
                <div class="public-footer-follow">
                    <h3 class="public-footer-social-heading">Follow us</h3>
                    <SocialLinks />
                </div>
            </div>

            <div class="public-footer-col">
                <h3>Services</h3>
                <ul>
                    <li><a href="services/carpet-cleaning">Carpet Cleaning</a></li>
                    <li><a href="services/carpet-repairs">Carpet Repairs</a></li>
                    <li><a href="services/commercial-carpet-cleaning">Commercial Carpet Cleaning</a></li>
                    <li><a href="services/pet-odor-removal">Pet Odor Removal</a></li>
                    <li><a href="services/tile-stone-grout">Tile, Stone &amp; Grout Cleaning</a></li>
                    <li><a href="services/upholstery-cleaning">Upholstery Cleaning</a></li>
                    <li><a href="services/water-damage-restoration">Water Damage Restoration</a></li>
                </ul>
            </div>

            <div class="public-footer-col">
                <h3>Service Area</h3>
                <ul>
                    <li>Sugar Land</li>
                    <li>Houston</li>
                    <li>Katy</li>
                    <li>Richmond</li>
                    <li>Missouri City</li>
                    <li>Fulshear</li>
                </ul>
            </div>

            <div class="public-footer-col">
                <h3>Get in Touch</h3>
                <ul class="public-footer-contact">
                    <li>
                        <span class="bi bi-telephone-fill" aria-hidden="true"></span>
                        <a href="tel:+17139060918">(713) 906-0918</a>
                    </li>
                    <li>
                        <span class="bi bi-clock-fill" aria-hidden="true"></span>
                        Mon&ndash;Fri: 9:00 AM &ndash; 6:00 PM
                    </li>
                    <li>
                        <span class="bi bi-geo-alt-fill" aria-hidden="true"></span>
                        Harris &amp; Fort Bend County, TX
                    </li>
                </ul>
                @*
                    Left as a plain link so middle-click and ctrl-click still open
                    the quote page in a new tab; the handler only records that this
                    particular button was the thing that navigated.
                *@
                <a class="public-footer-cta" href="quote" @onclick="OnQuoteCtaClick">Request a Free Quote</a>
            </div>
        </div>

        <div class="public-footer-bottom">
            <span>&copy; @DateTime.Now.Year New Era Steam Cleaning &amp; Restoration. All Rights Reserved.</span>
            <nav class="public-footer-links" aria-label="Footer">
                <a href="about">About</a>
                <a href="pricing">Pricing</a>
                <a href="services">Services</a>
                <a href="job-photos">Job Photos</a>
                <a href="guarantee">Guarantee</a>
            </nav>
        </div>
    </footer>
</div>

@code {
    // The mobile burger menu is a CSS-only checkbox: PublicLayout.razor.css opens
    // the nav with `.public-nav-toggle:checked ~ .public-nav` below 1240px. In the
    // WordPress theme, which ships the same markup, every nav item is a full page
    // load, so the new document arrives with the checkbox unticked and the menu
    // closes itself. Here the router navigates with pushState instead: this layout
    // and the <input> node both survive, nothing resets `checked`, and the menu
    // stayed open on top of the page the visitor had just picked.
    //
    // Binding the checkbox puts that state in the render tree so navigation can
    // clear it. LocationChanged is the whole fix on its own -- Blazor pushes state
    // even when the link points at the page you are already on, so re-picking the
    // current page closes the menu too, as do the back and forward buttons.
    private bool _navOpen;

    // Scroll position is the other thing a full page load used to give us. The
    // router keeps the viewport where it was on every navigation, so picking a
    // nav item while scrolled down left the visitor part-way into the page they
    // had just chosen -- and picking the page they were already on did nothing at
    // all. PublicLayout.razor.js puts the WordPress behaviour back.
    private IJSObjectReference? _scroll;

    // Set by the footer's green CTA. On the quote page a plain navigation to
    // /quote is invisible, so that one button scrolls to the form instead of the
    // top. Only the footer CTA does this, which is why it needs its own flag
    // rather than a rule about the quote page in general.
    private bool _quoteCtaWantsForm;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _scroll = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./Layout/PublicLayout.razor.js");
        }
    }

    private void OnQuoteCtaClick()
    {
        // Only when the click cannot navigate anywhere -- from any other page the
        // normal "land at the top of the quote page" behaviour is what we want.
        _quoteCtaWantsForm = IsOnQuotePage();
    }

    private bool IsOnQuotePage() =>
        Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/').Split(new[] { '?', '#' })[0]
           .Equals("quote", StringComparison.OrdinalIgnoreCase);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_navOpen)
        {
            _navOpen = false;
            InvokeAsync(StateHasChanged);
        }

        var wantsForm = _quoteCtaWantsForm;
        _quoteCtaWantsForm = false;

        // A destination with a fragment already has a scroll target of its own
        // (the job photo lightbox, the home page's #contact button). Stealing the
        // viewport back to the top would break those.
        if (!wantsForm && e.Location.Contains('#'))
        {
            return;
        }

        InvokeAsync(async () =>
        {
            if (_scroll is null)
            {
                return;
            }

            if (wantsForm && await _scroll.InvokeAsync<bool>("scrollToQuoteForm"))
            {
                return;
            }

            await _scroll.InvokeVoidAsync("scrollToTop");
        });
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
