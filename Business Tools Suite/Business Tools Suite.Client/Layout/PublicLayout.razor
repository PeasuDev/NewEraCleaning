@inherits LayoutComponentBase

@*
    Public-facing marketing chrome for neweracleaning.com. Wraps anonymous
    marketing pages with a sticky header and a content-rich footer. The admin
    dashboard uses MainLayout instead; a discreet link to /admin lives in the
    footer for staff.
*@

<div class="public-shell">
    <header class="public-header">
        <div class="public-header-inner">
            <a class="public-brand" href="/">
                <img src="new-era-logo.png" alt="New Era Steam Cleaning &amp; Restoration logo" class="public-brand-logo" />
                <span class="public-brand-text">
                    <span class="public-brand-name">New Era Steam Cleaning</span>
                    <span class="public-brand-sub">&amp; Restoration</span>
                </span>
            </a>

            <input type="checkbox" id="public-nav-toggle" class="public-nav-toggle" />
            <label for="public-nav-toggle" class="public-nav-burger" aria-label="Toggle navigation">
                <span></span><span></span><span></span>
            </label>

            <nav class="public-nav" aria-label="Primary">
                <a href="/">Home</a>
                <a href="about">About</a>
                <a href="services">Services</a>
                <a href="pricing">Pricing</a>
                <a href="job-photos">Job Photos</a>
                <a href="guarantee">Guarantee</a>
                <a href="quote">Get a Quote</a>
            </nav>

            <a class="public-call" href="tel:+17139060918">
                <span class="bi bi-telephone-fill" aria-hidden="true"></span>
                <span class="public-call-text">
                    <span class="public-call-label">Call for a free quote</span>
                    <span class="public-call-number">(713) 906-0918</span>
                </span>
            </a>
        </div>
    </header>

    <main class="public-main">
        @Body
    </main>

    <footer class="public-footer">
        <div class="public-footer-inner">
            <div class="public-footer-brand">
                <img src="new-era-logo.png" alt="New Era Steam Cleaning &amp; Restoration logo" class="public-footer-logo" />
                <p class="public-footer-tagline">
                    A local, family-owned steam cleaning company proudly serving the
                    greater Houston area since 2014. Guaranteed, bonded &amp; insured.
                </p>
                <p class="public-footer-green">
                    <span class="bi bi-flower1" aria-hidden="true"></span>
                    Organic, all-natural green options available on request.
                </p>
                <div class="public-footer-follow">
                    <h3 class="public-footer-social-heading">Follow us</h3>
                    <div class="public-footer-social">
                        <a class="social-link social-facebook" href="https://www.facebook.com/newerasteamclean"
                           target="_blank" rel="noopener noreferrer" aria-label="New Era Steam Cleaning on Facebook">
                            <svg viewBox="0 0 320 512" fill="currentColor" aria-hidden="true" focusable="false">
                                <path d="M80 299.3V512H196V299.3h86.5l18-97.8H196V166.9c0-51.7 20.3-71.5 72.7-71.5c16.3 0 29.4 .4 37 1.2V7.9C291.4 4 256.4 0 236.2 0C129.3 0 80 50.5 80 159.4v42.1H14v97.8H80z" />
                            </svg>
                        </a>
                        <a class="social-link social-yelp" href="https://www.yelp.com/biz/new-era-steam-cleaning-and-restoration-sugar-land"
                           target="_blank" rel="noopener noreferrer" aria-label="New Era Steam Cleaning on Yelp">
                            <svg viewBox="0 0 384 512" fill="currentColor" aria-hidden="true" focusable="false">
                                <path d="M42.9 240.32l99.62 48.61c19.2 9.4 16.2 37.51-4.5 42.71L30.5 358.45a22.79 22.79 0 0 1-28.21-19.6 197.16 197.16 0 0 1 9-85.32 22.8 22.8 0 0 1 31.61-13.21zm44 239.25a199.45 199.45 0 0 0 79.42 32.11A22.78 22.78 0 0 0 192.94 490l3.9-110.82c.7-21.3-25.5-31.91-39.81-16.1l-74.21 82.4a22.82 22.82 0 0 0 4.09 34.09zm145.34-109.92l58.81 94a22.93 22.93 0 0 0 34 5.5 198.36 198.36 0 0 0 52.71-67.61A23 23 0 0 0 364.17 370l-105.42-34.26c-20.31-6.5-37.81 15.8-26.51 33.91zm148.33-132.23a197.44 197.44 0 0 0-50.41-69.31 22.85 22.85 0 0 0-34 4.4l-62 91.92c-11.9 17.7 4.7 40.61 25.2 34.71L366 268.63a23 23 0 0 0 14.61-31.21zM62.11 30.18a22.86 22.86 0 0 0-9.9 32l104.12 180.44c11.7 20.2 42.61 11.9 42.61-11.4V22.88a22.67 22.67 0 0 0-24.5-22.8 320.37 320.37 0 0 0-112.33 30.1z" />
                            </svg>
                        </a>
                        <a class="social-link social-angi" href="https://www.angi.com/companylist/us/tx/austin/new-era-steam-cleaning-and-restoration-reviews-8435486.htm"
                           target="_blank" rel="noopener noreferrer" aria-label="New Era Steam Cleaning on Angi">
                            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                                <path d="m32.464 39.567l5.895.053L32.61 4.5h-8.584l-2.663 18.146c-.214 1.97-1.725 15.785-4.31 15.238c-5.07-3.454.625-9.686 3.088-9.28c9.285-1.3 11.791 2.027 12.324 10.963Z" />
                                <path d="m28.466 9.954l-1.94 13.23a8.2 8.2 0 0 1 2.6.726a14 14 0 0 1 1.364.76ZM14.82 42.677a10.48 10.48 0 0 1-4.631-12.436a9.71 9.71 0 0 1 10.997-6.696" />
                                <path d="M14.682 42.607c8.203 4.103 10.078-6.858 11.131-14.003" />
                            </svg>
                        </a>
                    </div>
                </div>
            </div>

            <div class="public-footer-col">
                <h3>Services</h3>
                <ul>
                    <li><a href="services/carpet-cleaning">Carpet Cleaning</a></li>
                    <li><a href="services/carpet-repairs">Carpet Repairs</a></li>
                    <li><a href="services/commercial-carpet-cleaning">Commercial Carpet Cleaning</a></li>
                    <li><a href="services/pet-odor-removal">Pet Odor Removal</a></li>
                    <li><a href="services/tile-stone-grout">Tile, Stone &amp; Grout Cleaning</a></li>
                    <li><a href="services/upholstery-cleaning">Upholstery Cleaning</a></li>
                    <li><a href="services/water-damage-restoration">Water Damage Restoration</a></li>
                </ul>
            </div>

            <div class="public-footer-col">
                <h3>Service Area</h3>
                <ul>
                    <li>Sugar Land</li>
                    <li>Houston</li>
                    <li>Katy</li>
                    <li>Richmond</li>
                    <li>Missouri City</li>
                    <li>Fulshear</li>
                </ul>
            </div>

            <div class="public-footer-col">
                <h3>Get in Touch</h3>
                <ul class="public-footer-contact">
                    <li>
                        <span class="bi bi-telephone-fill" aria-hidden="true"></span>
                        <a href="tel:+17139060918">(713) 906-0918</a>
                    </li>
                    <li>
                        <span class="bi bi-clock-fill" aria-hidden="true"></span>
                        Mon&ndash;Sun: 9:00 AM &ndash; 6:00 PM
                    </li>
                    <li>
                        <span class="bi bi-geo-alt-fill" aria-hidden="true"></span>
                        Harris &amp; Fort Bend County, TX
                    </li>
                </ul>
                <a class="public-footer-cta" href="quote">Request a Free Quote</a>
            </div>
        </div>

        <div class="public-footer-bottom">
            <span>&copy; @DateTime.Now.Year New Era Steam Cleaning &amp; Restoration. All Rights Reserved.</span>
            <nav class="public-footer-links" aria-label="Footer">
                <a href="about">About</a>
                <a href="pricing">Pricing</a>
                <a href="pricing#specials">Specials</a>
                <a href="job-photos">Job Photos</a>
                <a href="guarantee">Guarantee</a>
            </nav>
            <a class="public-footer-admin" href="admin">
                <span class="bi bi-shield-lock" aria-hidden="true"></span> Staff Admin
            </a>
        </div>
    </footer>
</div>
