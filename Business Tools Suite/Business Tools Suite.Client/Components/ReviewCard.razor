@*
    Reusable card that renders a single customer review. Used on the Reviews
    page and available for the dashboard or anywhere else reviews are shown.
*@

<div class="surface-card review-card">
    <div class="review-header">
        <div class="reviewer">
            <span class="reviewer-avatar">@GetInitials(Review.Author)</span>
            <div class="reviewer-meta">
                <span class="reviewer-name">@Review.Author</span>
                <span class="review-source">
                    <span class="source-badge source-@Review.Source.ToLowerInvariant()">@Review.Source</span>
                    @Review.Date.ToString("MMM d, yyyy")
                </span>
            </div>
        </div>
        <span class="review-stars" aria-label="@Review.Rating out of 5 stars">@RenderStars(Review.Rating)</span>
    </div>
    <p class="review-text">@Review.Text</p>
    <a class="review-link" href="@PlatformUrl(Review.Source)" target="_blank" rel="noopener noreferrer">
        View on @Review.Source
        <span class="bi bi-box-arrow-up-right" aria-hidden="true"></span>
    </a>
</div>

@code {
    /// <summary>
    /// The review to display.
    /// </summary>
    [Parameter, EditorRequired]
    public Review Review { get; set; } = default!;

    /// <summary>
    /// Maps a review source to the public platform page where the business's
    /// reviews can be viewed. Falls back to a search for the source name.
    /// </summary>
    private static string PlatformUrl(string source) => source switch
    {
        "Google" => "https://www.google.com/search?q=New+Era+Cleaning+reviews",
        "Yelp" => "https://www.yelp.com/biz/new-era-steam-cleaning-and-restoration-sugar-land",
        "Facebook" => "https://www.facebook.com/newerasteamclean",
        "Angi" => "https://www.angi.com/companylist/us/tx/austin/new-era-steam-cleaning-and-restoration-reviews-8435486.htm",
        _ => $"https://www.google.com/search?q=New+Era+Cleaning+{Uri.EscapeDataString(source)}+reviews"
    };

    private static string RenderStars(double rating)
    {
        var rounded = (int)Math.Round(rating);
        return new string('★', rounded) + new string('☆', 5 - rounded);
    }

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
        {
            return "?";
        }

        var initials = parts[0][0].ToString();
        if (parts.Length > 1)
        {
            initials += parts[^1][0];
        }

        return initials.ToUpperInvariant();
    }
}
