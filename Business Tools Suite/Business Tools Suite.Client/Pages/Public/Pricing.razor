@page "/pricing"
@layout PublicLayout

@*
    Public Pricing page. Presents transparent starting prices and what's
    included. Final quotes are always free and based on the specific space.
*@

<SeoHead Title="Carpet &amp; Steam Cleaning Pricing"
         Description="Transparent, affordable steam cleaning pricing from New Era Cleaning &amp; Restoration. Get a free, no-obligation quote for carpet, tile, upholstery, and restoration services across the greater Houston area."
         RelativePath="pricing" />

<PageBanner Title="Simple, Transparent Pricing"
            Subtitle="Honest rates with no hidden fees. Every quote is free and tailored to your space." />

<section class="section">
    <div class="section-inner">
        <div class="section-head">
            <span class="section-eyebrow">Our Packages</span>
            <h2 class="section-title">Choose What Fits Your Needs</h2>
            <p class="section-sub">
                Starting prices below. Because every home and business is different, your final
                price depends on square footage, condition, and service &mdash; so we always confirm
                with a free quote first.
            </p>
        </div>

        <div class="pricing-grid">
            <article class="price-card">
                <h3 class="price-name">Carpet Refresh</h3>
                <p class="price-desc">Great for routine maintenance and lightly soiled carpet.</p>
                <div class="price-amount"><span class="from">from</span> <strong>$139</strong></div>
                <ul class="price-features">
                    <li><span class="bi bi-check-lg" aria-hidden="true"></span> Up to 2 rooms</li>
                    <li><span class="bi bi-check-lg" aria-hidden="true"></span> Hot-water steam extraction</li>
                    <li><span class="bi bi-check-lg" aria-hidden="true"></span> Spot pre-treatment</li>
                    <li><span class="bi bi-check-lg" aria-hidden="true"></span> Fast-dry finish</li>
                </ul>
                <a class="btn-outline btn-block" href="quote">Get a Quote</a>
            </article>

            <article class="price-card price-card-featured">
                <span class="price-badge">Most Popular</span>
                <h3 class="price-name">Whole-Home Deep Clean</h3>
                <p class="price-desc">Our most-requested package for a top-to-bottom refresh.</p>
                <div class="price-amount"><span class="from">from</span> <strong>$229</strong></div>
                <ul class="price-features">
                    <li><span class="bi bi-check-lg" aria-hidden="true"></span> Up to 5 rooms</li>
                    <li><span class="bi bi-check-lg" aria-hidden="true"></span> High-traffic lane treatment</li>
                    <li><span class="bi bi-check-lg" aria-hidden="true"></span> Pet odor &amp; stain treatment</li>
                    <li><span class="bi bi-check-lg" aria-hidden="true"></span> Hallway &amp; stairs included</li>
                    <li><span class="bi bi-check-lg" aria-hidden="true"></span> Organic green option available</li>
                </ul>
                <a class="btn-primary-lg btn-block" href="quote">Get a Quote</a>
            </article>

            <article class="price-card">
                <h3 class="price-name">Specialty &amp; Commercial</h3>
                <p class="price-desc">Tile &amp; grout, upholstery, restoration, and commercial jobs.</p>
                <div class="price-amount"><strong>Custom</strong></div>
                <ul class="price-features">
                    <li><span class="bi bi-check-lg" aria-hidden="true"></span> Tile, stone &amp; grout cleaning</li>
                    <li><span class="bi bi-check-lg" aria-hidden="true"></span> Upholstery &amp; fabric care</li>
                    <li><span class="bi bi-check-lg" aria-hidden="true"></span> Water damage restoration</li>
                    <li><span class="bi bi-check-lg" aria-hidden="true"></span> Recurring commercial plans</li>
                </ul>
                <a class="btn-outline btn-block" href="quote">Get a Quote</a>
            </article>
        </div>

        <p class="price-note">
            <span class="bi bi-info-circle" aria-hidden="true"></span>
            Prices are starting estimates and may vary by square footage and condition. All work is
            guaranteed, bonded &amp; insured.
        </p>
    </div>
</section>

<!-- ===================== SPECIALS / COMBO DEALS ===================== -->
<section class="section section-alt" id="specials">
    <div class="section-inner">
        <div class="section-head">
            <span class="section-eyebrow">Current Specials</span>
            <h2 class="section-title">Combo Deals That Maximize Your Savings</h2>
            <p class="section-sub">
                In need of more than one of our services? You're in luck! We're currently offering
                combo deals that maximize your savings. We like keeping these offers fresh, so check
                back frequently to see our latest specials.
            </p>
        </div>

        <div class="services-grid">
            <article class="service-card">
                <span class="service-icon"><span class="bi bi-grid-3x3-gap-fill" aria-hidden="true"></span></span>
                <h3 class="service-name">Tile &amp; Carpet Combo</h3>
                <p class="service-text">Get more than 600 sq ft of tile cleaned and receive <strong>50% off</strong> a carpet cleaning.</p>
                <a class="service-link" href="quote">Claim this deal <span class="bi bi-arrow-right" aria-hidden="true"></span></a>
            </article>
            <article class="service-card">
                <span class="service-icon"><span class="bi bi-droplet-half" aria-hidden="true"></span></span>
                <h3 class="service-name">Carpet &amp; Upholstery Combo</h3>
                <p class="service-text">Get carpet and upholstery cleaned and receive <strong>25% off</strong> the upholstery cleaning.</p>
                <a class="service-link" href="quote">Claim this deal <span class="bi bi-arrow-right" aria-hidden="true"></span></a>
            </article>
        </div>

        <p class="price-note">
            <span class="bi bi-shield-check" aria-hidden="true"></span>
            We are insured &amp; bonded and all work comes with a 10-day guarantee. Call us at
            (713)&nbsp;906-0918 or request your free quote to take advantage of these specials.
        </p>
    </div>
</section>

<!-- ===================== CURRENT COUPON PRICES ===================== -->
<section class="section" id="coupon-prices">
    <div class="section-inner">
        <div class="section-head">
            <span class="section-eyebrow">Current Coupon Prices</span>
            <h2 class="section-title">Cleaning Services &amp; Current Coupon Prices</h2>
            <p class="section-sub">
                This page gives you the opportunity to see our current coupon offers. These prices are
                subject to change, unless you have already booked. We take great pride in offering
                high-quality services at competitive prices. To give you an idea of how we will quote
                your job, we've compiled a list of prices for each service. Prices can fluctuate with
                larger homes and oversized rooms, while house coupons include up to 6 rooms, halls and
                closets. Questions about our pricing? Call us at (713)&nbsp;906-0918. Don't forget to
                also check out our <a href="pricing#specials">specials</a> and see if you can get a discount!
            </p>
        </div>

        @foreach (var table in priceTables)
        {
            <h3 class="price-table-title">@table.Title</h3>
            <div class="price-table-wrap">
                <table class="price-table">
                    <thead>
                        <tr>
                            <th scope="col">Service</th>
                            <th scope="col">Description</th>
                            <th scope="col">Pricing or incident</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in table.Rows)
                        {
                            <tr>
                                <th scope="row">@row.Service</th>
                                <td>@row.Description</td>
                                <td class="price-table-amount">@row.Price</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <p class="price-note">
            <span class="bi bi-info-circle" aria-hidden="true"></span>
            *Whole house coupon based on total square footage of your entire home.
        </p>
    </div>
</section>

<CtaBand Heading="Get your exact price — free"
         Subheading="Send us a few details and we'll follow up with a no-obligation quote." />

