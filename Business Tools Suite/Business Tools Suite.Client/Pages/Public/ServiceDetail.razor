@page "/services/{Slug}"
@layout PublicLayout
@inject NavigationManager Nav

@*
    Per-service detail page driven by the shared ServiceCatalog. The slug in the
    route maps to a ServiceItem; unknown slugs redirect back to the services
    index. Includes an inline quote form preset to this service.
*@

@if (service is null)
{
    <PageBanner Title="Service not found" Subtitle="The service you're looking for doesn't exist." ParentLabel="Services" ParentHref="services" />
    <section class="section">
        <div class="section-inner section-narrow" style="text-align:center;">
            <a class="btn-primary-lg" href="services">Browse all services <span class="bi bi-arrow-right" aria-hidden="true"></span></a>
        </div>
    </section>
}
else
{
    <SeoHead Title="@($"{service.Name} in Houston")"
             Description="@service.Summary"
             RelativePath="@($"services/{service.Slug}")" />

    <PageBanner Title="@service.Name"
                Subtitle="@service.Tagline"
                ParentLabel="Services"
                ParentHref="services" />

    <section class="section">
        <div class="section-inner section-narrow prose">
            <h2>@service.Tagline</h2>
            <p>@service.LongDescription</p>

            <h3>What's included</h3>
            <ul class="check-list">
                @foreach (var highlight in service.Highlights)
                {
                    <li><span class="bi bi-check-circle-fill" aria-hidden="true"></span> @highlight</li>
                }
            </ul>

            <p class="price-note" style="text-align:left;margin-top:1.5rem;">
                <span class="bi bi-patch-check-fill" aria-hidden="true"></span>
                Our technicians are insured &amp; bonded, and every job is backed by our
                10-day, no-hassle guarantee. Organic, all-natural green options are available
                on request. Check out our <a href="pricing">price list</a> or request a free,
                personalized quote.
            </p>

            <div class="hero-actions" style="margin-top:1.5rem;">
                @* Relative href, matching "pricing" above: it resolves against
                   <base href="/">. A fragment-only href would not - "#service-quote"
                   resolves against the base too, sending the visitor to the home
                   page instead of the form below. *@
                <a class="btn-primary-lg" href="@($"quote?service={Uri.EscapeDataString(service.Name)}")">
                    Get a Free Quote
                    <span class="bi bi-arrow-right" aria-hidden="true"></span>
                </a>
                <a class="btn-outline" href="tel:+17139060918">
                    <span class="bi bi-telephone-fill" aria-hidden="true"></span>
                    (713) 906-0918
                </a>
            </div>
        </div>
    </section>

    <!-- Other services -->
    <section class="section section-alt">
        <div class="section-inner">
            <div class="section-head">
                <span class="section-eyebrow">More Services</span>
                <h2 class="section-title">Explore What Else We Do</h2>
            </div>
            <div class="services-grid">
                @foreach (var other in ServiceCatalog.All.Where(s => s.Slug != service.Slug).Take(3))
                {
                    <article class="service-card">
                        <span class="service-icon"><span class="bi @other.Icon" aria-hidden="true"></span></span>
                        <h3 class="service-name">@other.Name</h3>
                        <p class="service-text">@other.Summary</p>
                        <a class="service-link" href="services/@other.Slug">Learn more <span class="bi bi-arrow-right" aria-hidden="true"></span></a>
                    </article>
                }
            </div>
        </div>
    </section>

    <!-- Quote -->
    <QuoteSection SectionId="service-quote" FormName="service-quote" PreselectedService="@service.Name" />
}

@code {
    /// <summary>URL slug identifying the service (from the route).</summary>
    [Parameter] public string Slug { get; set; } = string.Empty;

    private ServiceItem? service;

    protected override void OnParametersSet()
    {
        service = ServiceCatalog.FindBySlug(Slug);
    }
}
