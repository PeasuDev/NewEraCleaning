@page "/"
@layout PublicLayout
@inject PlaceholderDataService DataService
@inject IReviewProvider ReviewProvider

@*
    Public marketing home page for New Era Steam Cleaning & Restoration. Anonymous,
    SEO-optimized (prerendered HTML, meta tags, Open Graph, and LocalBusiness
    JSON-LD). The quote form feeds the admin Quote Requests via the shared
    PlaceholderDataService.
*@

<PageTitle>Houston Carpet Cleaning &amp; Steam Cleaning | New Era Steam Cleaning &amp; Restoration</PageTitle>

<HeadContent>
    <meta name="description" content="New Era Steam Cleaning &amp; Restoration offers home and commercial steam cleaning for carpets, tile, stone, and upholstery in Sugar Land, Houston, Katy, Richmond, Missouri City, and Fulshear. Family-owned, bonded &amp; insured. Call (713) 906-0918 for a free quote." />
    <meta name="keywords" content="carpet cleaning Houston, steam cleaning Sugar Land, tile and grout cleaning Katy, upholstery cleaning Richmond, pet odor removal, water damage restoration, commercial carpet cleaning" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://neweracleaning.com/" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="New Era Steam Cleaning &amp; Restoration" />
    <meta property="og:title" content="Houston Carpet &amp; Steam Cleaning | New Era Steam Cleaning &amp; Restoration" />
    <meta property="og:description" content="Family-owned steam cleaning for carpets, tile, stone &amp; upholstery across the greater Houston area. Organic green options available. Get a free quote today." />
    <meta property="og:url" content="https://neweracleaning.com/" />
    <meta property="og:image" content="https://neweracleaning.com/new-era-logo.png" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Houston Carpet &amp; Steam Cleaning | New Era Steam Cleaning &amp; Restoration" />
    <meta name="twitter:description" content="Family-owned steam cleaning for carpets, tile, stone &amp; upholstery across the greater Houston area. Get a free quote today." />
    <meta name="twitter:image" content="https://neweracleaning.com/new-era-logo.png" />

    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "HousePainter",
        "@@id": "https://neweracleaning.com/#business",
        "name": "New Era Steam Cleaning & Restoration",
        "image": "https://neweracleaning.com/new-era-logo.png",
        "description": "Local, family-owned steam cleaning company serving residential and commercial customers across the greater Houston area since 2014.",
        "url": "https://neweracleaning.com/",
        "telephone": "+1-713-906-0918",
        "foundingDate": "2014",
        "priceRange": "$$",
        "areaServed": ["Sugar Land", "Houston", "Katy", "Richmond", "Missouri City", "Fulshear"],
        "address": {
            "@@type": "PostalAddress",
            "addressRegion": "TX",
            "addressCountry": "US"
        },
        "openingHoursSpecification": {
            "@@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
            "opens": "09:00",
            "closes": "18:00"
        }
    }
    </script>
</HeadContent>

<!-- ===================== HERO ===================== -->
<section class="hero">
    <div class="hero-inner">
        <div class="hero-copy">
            <span class="hero-eyebrow">
                <span class="bi bi-patch-check-fill" aria-hidden="true"></span>
                Sugar Land &middot; Houston &middot; Katy &amp; surrounding areas
            </span>
            <h1 class="hero-title">
                Houston's Trusted <span class="hero-accent">Steam&nbsp;Cleaning</span> &amp; Restoration Experts
            </h1>
            <p class="hero-lead">
                Recapture your carpet's youth. New Era Steam Cleaning &amp; Restoration is a local,
                family-owned company delivering deep, hospital-grade steam cleaning for
                carpets, tile, stone, and upholstery &mdash; backed by @CompanyFacts.YearsOfExperience+ years of experience.
            </p>
            <div class="hero-actions">
                <a class="btn-primary-lg" href="#contact">
                    Get a Free Quote
                    <span class="bi bi-arrow-right" aria-hidden="true"></span>
                </a>
                <a class="btn-ghost-lg" href="tel:+17139060918">
                    <span class="bi bi-telephone-fill" aria-hidden="true"></span>
                    (713) 906-0918
                </a>
            </div>
            <ul class="hero-trust">
                <li><span class="bi bi-shield-check" aria-hidden="true"></span> Guaranteed, Bonded &amp; Insured</li>
                <li><span class="bi bi-flower1" aria-hidden="true"></span> Organic Green Options</li>
                <li><span class="bi bi-people-fill" aria-hidden="true"></span> Family-Owned Since 2014</li>
            </ul>
        </div>
        <div class="hero-card" aria-hidden="false">
            <div class="hero-card-rating">
                <div class="hero-stars">
                    <span class="bi bi-star-fill"></span><span class="bi bi-star-fill"></span><span class="bi bi-star-fill"></span><span class="bi bi-star-fill"></span><span class="bi bi-star-fill"></span>
                </div>
                <strong>@averageRating.ToString("0.0")</strong>
                <span class="hero-card-rating-label">from @reviewCount reviews</span>
            </div>
            <p class="hero-card-quote">
                &ldquo;@featuredReview?.Text&rdquo;
            </p>
            <span class="hero-card-author">&mdash; @(featuredReview?.Author ?? "Verified Customer"), @(featuredReview?.Source ?? "Google")</span>
            <a class="hero-card-cta" href="#contact">Schedule your cleaning &rarr;</a>
        </div>
    </div>
</section>

<!-- ===================== CAROUSEL ===================== -->
<section class="section carousel-section" aria-label="Our work in action">
    <div class="section-inner">
        <div class="carousel" role="group" aria-roledescription="carousel">
            @for (var i = 0; i < carouselSlides.Count; i++)
            {
                <input type="radio" name="home-carousel" id="@($"carousel-{i}")"
                       class="carousel-radio" checked="@(i == 0)" />
            }

            <div class="carousel-track">
                @foreach (var slide in carouselSlides)
                {
                    <figure class="carousel-slide">
                        <img src="@slide.Image" alt="@slide.Caption" loading="lazy" />
                        <figcaption class="carousel-caption">@slide.Caption</figcaption>
                    </figure>
                }
            </div>

            <div class="carousel-arrows" aria-hidden="true">
                @for (var i = 0; i < carouselSlides.Count; i++)
                {
                    var prev = (i - 1 + carouselSlides.Count) % carouselSlides.Count;
                    var next = (i + 1) % carouselSlides.Count;
                    <div class="carousel-arrow-pair" id="@($"carousel-arrows-{i}")">
                        <label class="carousel-arrow carousel-arrow-prev" for="@($"carousel-{prev}")">
                            <span class="bi bi-chevron-left"></span>
                        </label>
                        <label class="carousel-arrow carousel-arrow-next" for="@($"carousel-{next}")">
                            <span class="bi bi-chevron-right"></span>
                        </label>
                    </div>
                }
            </div>

            <div class="carousel-dots">
                @for (var i = 0; i < carouselSlides.Count; i++)
                {
                    <label class="carousel-dot" id="@($"carousel-dot-{i}")"
                           for="@($"carousel-{i}")" aria-label="Show slide @(i + 1)"></label>
                }
            </div>
        </div>
    </div>
</section>

<!-- ===================== BRAND LOGO ===================== -->
<section class="section brand-logo-feature" aria-label="New Era Steam Cleaning & Restoration">
    <img src="new-era-logo.png" alt="New Era Steam Cleaning &amp; Restoration logo" loading="lazy" />
</section>

<!-- ===================== TRUST BAR ===================== -->
<section class="trust-bar">
    <div class="trust-bar-inner">
        <div class="trust-item"><span class="bi bi-clock-history" aria-hidden="true"></span> Open 7 Days &middot; 9:00 AM&ndash;6:00 PM</div>
        <div class="trust-item"><span class="bi bi-droplet-half" aria-hidden="true"></span> Truck-Mounted Steam Cleaning</div>
        <div class="trust-item"><span class="bi bi-geo-alt-fill" aria-hidden="true"></span> Harris &amp; Fort Bend County</div>
    </div>
</section>

<!-- ===================== SERVICES ===================== -->
<section class="section" id="services">
    <div class="section-inner">
        <div class="section-head">
            <span class="section-eyebrow">What We Do</span>
            <h2 class="section-title">Professional Cleaning Services</h2>
            <p class="section-sub">
                From everyday refreshes to post-construction deep cleans, no job is too large or
                too small. Our skilled technicians bring the best cleaning technology to every visit.
            </p>
        </div>

        <div class="services-grid">
            @foreach (var service in ServiceCatalog.All)
            {
                <article class="service-card">
                    <span class="service-icon"><span class="bi @service.Icon" aria-hidden="true"></span></span>
                    <h3 class="service-name">@service.Name</h3>
                    <p class="service-text">@service.Summary</p>
                    <a class="service-link" href="services/@service.Slug">Learn more <span class="bi bi-arrow-right" aria-hidden="true"></span></a>
                </article>
            }
        </div>
    </div>
</section>

<!-- ===================== ABOUT / WHY US ===================== -->
<section class="section section-alt" id="about">
    <div class="section-inner about-grid">
        <div class="about-copy">
            <span class="section-eyebrow">About New Era</span>
            <h2 class="section-title">Family-Owned &amp; Houston Proud</h2>
            <p>
                New Era Steam Cleaning &amp; Restoration was founded in 2014 by Charles Hegler to breathe
                new life into the Sugar Land, Houston, Katy, Richmond, Missouri City, and Fulshear
                steam cleaning scene. With a beautiful young family to support and a deep love for the
                craft, Charles set out to fulfill every Houstonian's dream &mdash;
                becoming part of the local community and starting his own business.
            </p>
            <p>
                We combine over @CompanyFacts.YearsOfExperience years of hands-on experience with the best cleaning technologies to deliver an
                outstanding floor-care experience. As Houston natives, we're dedicated to growing
                our business the right way &mdash; through superior service and exceptional customer
