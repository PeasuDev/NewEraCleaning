<!-- ===================== TESTIMONIALS ===================== -->
<section class="section" id="reviews">
    <div class="section-inner">
        <div class="section-head">
            <span class="section-eyebrow">Customer Reviews</span>
            <h2 class="section-title">What Houston Says About Us</h2>
            <p class="section-sub">Real feedback from homeowners and businesses across the area.</p>
        </div>
        <div class="testimonial-grid">
            @foreach (var review in testimonials)
            {
                <figure class="testimonial-card">
                    <div class="testimonial-stars">
                        @for (var i = 0; i < review.Rating; i++)
                        {
                            <span class="bi bi-star-fill" aria-hidden="true"></span>
                        }
                    </div>
                    <blockquote>&ldquo;@review.Text&rdquo;</blockquote>
                    <figcaption>
                        <span class="testimonial-author">@review.Author</span>
                        <span class="testimonial-source">via @review.Source</span>
