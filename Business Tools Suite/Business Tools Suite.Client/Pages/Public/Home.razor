    </div>
</section>

<!-- ===================== QUOTE FORM / CONTACT ===================== -->
<section class="section quote-section" id="contact">
    <div class="section-inner quote-grid">
        <div class="quote-intro">
            <span class="section-eyebrow section-eyebrow-light">Get Started</span>
            <h2 class="quote-title">You're Seconds Away From a Cleaner Space</h2>
            <p class="quote-lead">
                Tell us what you need and we'll get back to you with a free, no-obligation quote.
                Prefer to talk? Call us directly &mdash; we're happy to help.
            </p>
            <ul class="quote-contact">
                <li><span class="bi bi-telephone-fill" aria-hidden="true"></span> <a href="tel:+17139060918">(713) 906-0918</a></li>
                <li><span class="bi bi-clock-fill" aria-hidden="true"></span> Mon&ndash;Sun: 9:00 AM &ndash; 6:00 PM</li>
                <li><span class="bi bi-flower1" aria-hidden="true"></span> Ask about organic, green cleaning</li>
            </ul>
        </div>

        <QuoteForm FormName="home-quote" />
    </div>
</section>

@code {
    private IReadOnlyList<Review> testimonials = Array.Empty<Review>();
    private Review? featuredReview;
    private int reviewCount;
    private double averageRating;

    private readonly IReadOnlyList<string> serviceAreas = new List<string>
    {
        "Sugar Land", "Houston", "Katy", "Richmond", "Missouri City", "Fulshear"
    };

    private readonly IReadOnlyList<CarouselSlide> carouselSlides = new List<CarouselSlide>
    {
        new("img/carpet-carousel.jpg", "Deep steam-cleaned carpets, restored to like-new"),
        new("img/tile-floor-carousel.jpg", "Tile & grout brought back to a brilliant shine"),
        new("img/commercial-carousel.jpg", "Dependable commercial floor care for Houston businesses"),
    };

    private sealed record CarouselSlide(string Image, string Caption);

    protected override async Task OnInitializedAsync()
    {
        var reviews = await GetMergedReviewsAsync();
        reviewCount = reviews.Count;
        averageRating = reviews.Count > 0 ? reviews.Average(r => r.Rating) : 5.0;

        testimonials = reviews
            .Where(r => r.Rating >= 4)
            .OrderByDescending(r => r.Rating)
            .ThenByDescending(r => r.Date)
            .Take(3)
            .ToList();

        featuredReview = reviews
            .Where(r => r.Rating == 5)
            .OrderByDescending(r => r.Date)
            .FirstOrDefault() ?? reviews.FirstOrDefault();
    }

    // Prefer live Yelp reviews; merge them with placeholder reviews from other
    // sources. If Yelp is not configured or returns nothing, fall back to the
    // full placeholder set so the page always shows testimonials.
    private async Task<IReadOnlyList<Review>> GetMergedReviewsAsync()
    {
        var placeholders = DataService.GetReviews();
        var liveReviews = await ReviewProvider.GetLiveReviewsAsync();

        if (liveReviews.Count == 0)
        {
            return placeholders;
        }

        return liveReviews
            .Concat(placeholders.Where(r => r.Source != "Yelp"))
            .OrderByDescending(r => r.Date)
            .ToList();
    }
}
