@page "/guarantee"
@layout PublicLayout

@*
    Public Guarantee page. Reinforces trust: bonded & insured, with clear
    promises to the customer backed by our 10-day no-hassle guarantee.
*@

<SeoHead Title="Our Guarantee"
         Description="New Era Cleaning &amp; Restoration stands behind every job — guaranteed, bonded &amp; insured. If you're not happy, we'll make it right."
         RelativePath="guarantee" />

<PageBanner Title="Our Guarantee"
            Subtitle="We stand behind every job. If something isn't right, we'll come back and make it right." />

<section class="section">
    <div class="section-inner">
        <div class="guarantee-hero">
            <span class="guarantee-seal"><span class="bi bi-patch-check-fill" aria-hidden="true"></span></span>
            <h2>Our Promise to You</h2>
            <p>
                Quality work is the foundation of our business &mdash; that's our promise as a
                local, family-owned company. Our technicians are insured &amp; bonded, and every job
                is backed by our <strong>10-day, no-hassle guarantee</strong>.
            </p>
        </div>

        <div class="services-grid" style="margin-top:3rem;">
            <article class="service-card">
                <span class="service-icon"><span class="bi bi-hand-thumbs-up-fill" aria-hidden="true"></span></span>
                <h3 class="service-name">10-Day No-Hassle Guarantee</h3>
                <p class="service-text">If something isn't up to your standards, let us know within 10 days and we'll re-clean the area at no extra cost.</p>
            </article>
            <article class="service-card">
                <span class="service-icon"><span class="bi bi-shield-lock-fill" aria-hidden="true"></span></span>
                <h3 class="service-name">Bonded &amp; Insured</h3>
                <p class="service-text">Full coverage means total peace of mind whenever our team is in your home or business.</p>
            </article>
            <article class="service-card">
                <span class="service-icon"><span class="bi bi-cash-coin" aria-hidden="true"></span></span>
                <h3 class="service-name">No Hidden Fees</h3>
                <p class="service-text">The price we quote is the price you pay. No surprises, no upsells, no pressure.</p>
            </article>
            <article class="service-card">
                <span class="service-icon"><span class="bi bi-flower1" aria-hidden="true"></span></span>
                <h3 class="service-name">Safe &amp; Green</h3>
                <p class="service-text">Family- and pet-friendly methods, with organic, all-natural green options available on request.</p>
            </article>
        </div>
    </div>
</section>

<CtaBand Heading="Book with confidence"
         Subheading="Backed by our guarantee. Get your free quote today." />
