@page "/quote"
@layout PublicLayout

@*
    Dedicated Get a Quote page. The page is the banner plus <QuoteSection />,
    the same block the home page and every service page render, which in turn
    feeds submissions into the admin Quote Requests queue.
*@

<SeoHead Title="Get a Free Quote"
         Description="Request a free, no-obligation quote from New Era Steam Cleaning &amp; Restoration for carpet, tile, upholstery, pet odor, or restoration services across the greater Houston area. Call (713) 906-0918."
         RelativePath="quote" />

<PageBanner Title="Get a Free Quote"
            Subtitle="You're seconds away from a cleaner space. Tell us what you need and we'll be in touch." />

<QuoteSection FormName="quote-page" PreselectedService="@Service" />

@code {
    // Service pages link here as quote?service=<name> so the picker can open on
    // the service the visitor was reading about. QuoteForm checks the value
    // against ServiceCatalog.Names and ignores anything else, so an unrecognised
    // value falls back to the empty picker rather than breaking.
    [SupplyParameterFromQuery(Name = "service")]
    public string? Service { get; set; }
}
