@page "/about"
@layout PublicLayout

@*
    Public About page. Tells the New Era Cleaning & Restoration story
    (founded 2014 by Charles Hegler) with company values and stats.
*@

<SeoHead Title="About New Era Cleaning &amp; Restoration"
         Description="New Era Cleaning &amp; Restoration is a local, family-owned steam cleaning company founded in 2014 by Charles Hegler, proudly serving the greater Houston area with carpet, tile, upholstery, and restoration services."
         RelativePath="about" />

<PageBanner Title="About New Era Cleaning &amp; Restoration"
            Subtitle="A local, family-owned steam cleaning company proudly serving the greater Houston area since 2014." />

<!-- ===================== BRAND LOGO ===================== -->
<section class="section brand-logo-feature" aria-label="New Era Cleaning & Restoration">
    <img src="new-era-logo.png" alt="New Era Cleaning &amp; Restoration logo" loading="lazy" />
</section>

<!-- ===================== STORY ===================== -->
<section class="section">
    <div class="section-inner about-grid">
        <div class="about-copy">
            <span class="section-eyebrow">Our Story</span>
            <h2 class="section-title">Family-Owned &amp; Houston Proud</h2>
            <p>
                New Era Cleaning &amp; Restoration was founded in 2014 by Charles Hegler to breathe
                new life into the Sugar Land, Houston, Katy, Richmond, Missouri City, and Fulshear
                steam cleaning scene. With a beautiful young family to support and over 16 years of
                industry experience, Charles set out to fulfill every Houstonian's dream &mdash;
                becoming part of the local community and starting his own business.
            </p>
            <p>
                We combine that experience with the best cleaning technologies to deliver an
                outstanding floor-care experience. As Houston natives, we're dedicated to growing
                our business the right way &mdash; through superior service and exceptional customer
                care. Your recommendation is our greatest compliment.
            </p>
            <p>
                Whether it's a single room, an entire home, or a busy commercial space, no job is
                too large or too small. We treat every property as if it were our own.
            </p>
            <div class="about-points">
                <div class="about-point"><span class="bi bi-check-circle-fill" aria-hidden="true"></span> Residential &amp; commercial cleaning</div>
                <div class="about-point"><span class="bi bi-check-circle-fill" aria-hidden="true"></span> All work guaranteed, bonded &amp; insured</div>
                <div class="about-point"><span class="bi bi-check-circle-fill" aria-hidden="true"></span> Zero-contact service options available</div>
                <div class="about-point"><span class="bi bi-check-circle-fill" aria-hidden="true"></span> Natural, organic green cleaning on request</div>
            </div>
        </div>
        <div class="about-stats">
            <div class="stat-card">
                <strong>16+</strong>
                <span>Years of Experience</span>
            </div>
            <div class="stat-card">
                <strong>2014</strong>
                <span>Locally Founded</span>
            </div>
            <div class="stat-card">
                <strong>7</strong>
                <span>Specialized Services</span>
            </div>
            <div class="stat-card stat-card-brand">
                <strong>100%</strong>
                <span>Satisfaction Guaranteed</span>
            </div>
        </div>
    </div>
</section>

<!-- ===================== VALUES ===================== -->
<section class="section section-alt">
    <div class="section-inner">
        <div class="section-head">
            <span class="section-eyebrow">What Drives Us</span>
            <h2 class="section-title">Our Commitment to You</h2>
            <p class="section-sub">The principles behind every job we take on.</p>
        </div>
        <div class="services-grid">
            <article class="service-card">
                <span class="service-icon"><span class="bi bi-gem" aria-hidden="true"></span></span>
                <h3 class="service-name">Quality First</h3>
                <p class="service-text">We use professional, truck-mounted equipment and proven techniques to deliver a deep, lasting clean every visit.</p>
            </article>
            <article class="service-card">
                <span class="service-icon"><span class="bi bi-flower1" aria-hidden="true"></span></span>
                <h3 class="service-name">Green Options</h3>
                <p class="service-text">Prefer natural? Ask about our organic, all-natural green cleaning solutions that are safe for kids and pets.</p>
            </article>
            <article class="service-card">
                <span class="service-icon"><span class="bi bi-shield-check" aria-hidden="true"></span></span>
                <h3 class="service-name">Trust &amp; Safety</h3>
                <p class="service-text">Fully guaranteed, bonded &amp; insured. You can feel confident inviting our team into your home or business.</p>
            </article>
            <article class="service-card">
                <span class="service-icon"><span class="bi bi-people-fill" aria-hidden="true"></span></span>
                <h3 class="service-name">Local &amp; Personal</h3>
                <p class="service-text">We're your neighbors. Every customer is treated with the care and respect we'd give our own family.</p>
            </article>
        </div>
    </div>
</section>

<CtaBand Heading="Experience the New Era difference"
         Subheading="See why Houston families and businesses trust us with their floors and furniture." />
