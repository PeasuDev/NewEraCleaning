# Connection details for the deploy tooling.
#
# Copy to deploy.env (gitignored) and fill in. Nothing here is committed.

# --- WordPress REST -----------------------------------------------------------
#
# From Users -> Profile -> Application Passwords in wp-admin. The generated value
# is shown once, with spaces; keep or strip them, both work. It is a credential for
# an administrator account — put it here rather than pasting it into chat, and
# revoke it from that same screen if it ever needs to be.

WP_SITE=https://neweracleaning.com
WP_USER=
WP_APP_PASSWORD=

# --- SSH ----------------------------------------------------------------------
#
# DORMANT: needs SiteGround Site Tools access, which we do not have. Left in place
# because deploy-theme.sh's SSH path still works if a key is ever installed.
#
# SG_HOST=
# SG_USER=
# SG_PORT=18765
# SG_THEMES=
# SG_KEY=~/.ssh/newera_siteground
